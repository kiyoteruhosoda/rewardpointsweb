# docker compose / deploy.sh 用の設定テンプレート。cp .env.example .env で使う。
# 未設定の項目は docker-compose.yml の ${VAR:-default} が供給する（開発向け既定値）。
# .env そのものも任意で、手元の `docker compose up` は無くても起動する。
# 外部公開する環境では資格情報を必ず上書きすること。

# --- アプリ名 ---
# deploy.sh 経由なら、アプリ名は配置ディレクトリ（<アプリ名>/<stg|prod>/）から決まり
# コンテナ名・ネットワーク名・イメージタグもそこから作られる。ディレクトリ名を
# 使えないときだけここで明示する。
# APP_NAME=rewardpointsweb

# --- マウント・ポート ---
# ホストへ公開するのは nginx（WEB_BIND_ADDR:WEB_HOST_PORT）だけ。web / db へは
# Docker ネットワーク内部からしか到達できない（db はホストにポートを持たない）。
# HOST_DATA_ROOT=./mnt
# WEB_BIND_ADDR=127.0.0.1
# WEB_HOST_PORT=8080
# DB_CONTAINER_NAME=rewardpointsweb-mariadb
# DOCKER_NETWORK_NAME=rewardpointsweb

# --- DB 資格情報（上書き推奨） ---
# MARIADB_ROOT_PASSWORD=strong-mariadb-root-password-here
# MARIADB_USER=web_user
# MARIADB_PASSWORD=strong-mariadb-password-here
# MARIADB_DATABASE=appdb

# --- アプリケーション ---
# 初期管理者パスワード（未設定なら admin / 本番では必ず設定・変更する）
# ADMIN_INITIAL_PASSWORD=change-me-strong
# JWT_SECRET_KEY=strong-random-secret-here
# SECRET_KEY=strong-random-secret-here
# APP_BASE_URL=https://app.example.com
# CORS_ALLOWED_ORIGINS=["https://app.example.com"]

# --- パスキー（WebAuthn） ---
# パスキーは RP ID（ドメイン）に結び付く。変更すると登録済みのパスキーは
# すべて使えなくなるため、公開ドメインを決めてから設定する。
# WEBAUTHN_RP_ID=app.example.com
# WEBAUTHN_ORIGIN=https://app.example.com
# WEBAUTHN_RP_NAME=rewardpointsweb

# --- 外部 IdP（SSO / OpenID Connect）---
# 空のままなら SSO は無効。管理画面（/admin/config）からも設定できるので、
# ここへ書くのは「画面から変えさせたくない」ときだけにする（環境変数が優先）。
# SSO では利用者を作らない。IdP の検証済みメールアドレスが既存の利用者の
# email と一致したときだけ入れる（ADR-0029）。
# OIDC_ENABLED=true
# OIDC_ISSUER=https://idp.example/tenant
# OIDC_CLIENT_ID=rewardpointsweb-prod
# client_secret_basic なら CLIENT_SECRET、private_key_jwt なら PRIVATE_KEY_FILE
# OIDC_CLIENT_AUTH_METHOD=private_key_jwt
# OIDC_CLIENT_SECRET=
# 鍵はコンテナの実行ユーザーが読めること（ディレクトリにも通り抜けの権限が要る）
# OIDC_PRIVATE_KEY_FILE=/srv/secrets/oidc/client.key
# OIDC_PRIVATE_KEY_KID=
# 空なら APP_BASE_URL + /api/auth/sso/callback。IdP 側の登録と完全一致すること
# OIDC_REDIRECT_URI=https://app.example.com/api/auth/sso/callback

# --- ローカル開発（uv run python main.py）---
# 未設定なら sqlite:///app.db が使われる
# DATABASE_URI=sqlite:///app.db
