# Settings template for local development (`docker compose up`). Use with cp .env.example .env.
# Unset items are supplied by ${VAR:-default} in docker-compose.yml (development defaults).
# .env itself is optional; a local `docker compose up` starts without it.
# Always override the credentials in environments exposed externally.

# ⚠ **Deployment settings do not live here.** The k3s declaration (deploy-repo's
#   `k8s/rewardpointsweb-prod/20-config.yaml`) is the source of truth, and secrets are kept
#   **sealed** in `25-secrets.yaml` in the same directory.

# --- Mounts and ports ---
# Only nginx (WEB_BIND_ADDR:WEB_HOST_PORT) is exposed to the host. web / db are
# reachable only from inside the Docker network (db has no host port).
# HOST_DATA_ROOT=./mnt
# WEB_BIND_ADDR=127.0.0.1
# WEB_HOST_PORT=8080
# DB_CONTAINER_NAME=rewardpointsweb-mariadb
# DOCKER_NETWORK_NAME=rewardpointsweb

# --- DB credentials (override recommended) ---
# MARIADB_ROOT_PASSWORD=strong-mariadb-root-password-here
# MARIADB_USER=web_user
# MARIADB_PASSWORD=strong-mariadb-password-here
# MARIADB_DATABASE=appdb

# --- Application ---
# Initial admin password (admin if unset / always set and change it in production)
# ADMIN_INITIAL_PASSWORD=change-me-strong
# JWT_SECRET_KEY=strong-random-secret-here
# SECRET_KEY=strong-random-secret-here
# APP_BASE_URL=https://app.example.com
# CORS_ALLOWED_ORIGINS=["https://app.example.com"]

# --- Passkeys (WebAuthn) ---
# Passkeys are bound to the RP ID (domain). Changing it makes every registered passkey
# unusable, so set it after deciding the public domain.
# WEBAUTHN_RP_ID=app.example.com
# WEBAUTHN_ORIGIN=https://app.example.com
# WEBAUTHN_RP_NAME=rewardpointsweb

# --- External IdP (SSO / OpenID Connect) ---
# Leave empty to disable SSO. It can also be set from the admin screen (/admin/config), so
# only set it here when it must not be changed from the screen (environment variables take precedence).
# SSO does not create users. A user is let in only when the IdP's verified email address
# matches an existing user's email (ADR-0029).
# OIDC_ENABLED=true
# OIDC_ISSUER=https://idp.example/tenant
# OIDC_CLIENT_ID=rewardpointsweb-prod
# CLIENT_SECRET for client_secret_basic, PRIVATE_KEY_FILE for private_key_jwt
# OIDC_CLIENT_AUTH_METHOD=private_key_jwt
# OIDC_CLIENT_SECRET=
# The key must be readable by the container's runtime user (directories need traverse permission too)
# OIDC_PRIVATE_KEY_FILE=/srv/secrets/oidc/client.key
# OIDC_PRIVATE_KEY_KID=
# assay service account (periodic reconciliation, ADR-0040). Reconciliation does not run if empty
# MACHINE_CLIENT_ID=
# If empty, APP_BASE_URL + /api/auth/sso/callback. Must exactly match the IdP registration
# OIDC_REDIRECT_URI=https://app.example.com/api/auth/sso/callback

# --- Local development (uv run python main.py) ---
# sqlite:///app.db is used if unset
# DATABASE_URI=sqlite:///app.db
